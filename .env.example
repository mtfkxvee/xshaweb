# ERPNext (Frappe) integration — server-side only, never expose with a VITE_ prefix.
# Copy this file to .env and fill in real values. .env is gitignored.

# Base URL of the ERPNext site, no trailing slash.
ERPNEXT_URL=https://erp.example.com

# API Key/Secret from a Frappe "System Manager" (or scoped) user, used for
# server-to-server reads that are not tied to a logged-in customer
# (catalog, item groups, outlets). Generate under User > API Access.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Shared secret ERPNext's "Delivery Request" Server Script sends in the
# X-Notify-Secret header when calling /api/notifications/delivery (push
# notification to the customer when their order is shipped). Any long random
# string; the same value must be set in the Server Script.
PUSH_NOTIFY_SECRET=
